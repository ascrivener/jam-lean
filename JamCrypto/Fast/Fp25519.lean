def ofNat (x : Nat) : Elem := mul (rawOfNat (x % p)) r2

/-- The value (below p) of an element. -/
def toNat (a : Elem) : Nat := rawToNat (mul a ⟨1, 0, 0, 0, 0, 0, 0, 0, 0⟩)

/-- The value of an element is odd. -/
def isOdd (a : Elem) : Bool := (mul a ⟨1, 0, 0, 0, 0, 0, 0, 0, 0⟩).l0 &&& 1 == 1

/-- The bits of e, most significant first (empty for 0). -/
def bitsMsb (e : Nat) : Array Bool := Id.run do
  let n := if e == 0 then 0 else e.log2 + 1
  let mut out : Array Bool := Array.mkEmpty n
  for i in [0:n] do
    out := out.push (e.testBit (n - 1 - i))
  return out

/-- a^e for e given by its bits, most significant first. -/
def powBits (a : Elem) (bits : Array Bool) : Elem := Id.run do
  let mut r := one
  for b in bits do
    r := sq r
    if b then r := mul r a
  return r

/-- a^e. -/
def pow (a : Elem) (e : Nat) : Elem := powBits a (bitsMsb e)

/-- The bits of p − 2. -/
def pMinus2Bits : Array Bool := bitsMsb (p - 2)

/-- a⁻¹ (Fermat: a^(p−2)); 0 for 0. -/
def inv (a : Elem) : Elem := powBits a pMinus2Bits

/-- The bits of (p − 1)/2. -/
def halfBits : Array Bool := bitsMsb ((p - 1) / 2)

/-- a is a nonzero square (Euler's criterion). -/
def isSquare (a : Elem) : Bool := powBits a halfBits == one

/-- Batch inversion (Montgomery's trick); zero entries map to zero. -/
def batchInv (xs : Array Elem) : Array Elem := Id.run do
  let n := xs.size
  let mut pre : Array Elem := Array.mkEmpty n
  let mut acc := one
  for x in xs do
    pre := pre.push acc
    if !isZero x then acc := mul acc x
  let mut iv := inv acc
  let mut out : Array Elem := Array.replicate n zero
  for k in [0:n] do
    let i := n - 1 - k
    let x := xs[i]!
    if !isZero x then
      out := out.set! i (mul iv pre[i]!)
      iv := mul iv x
  return out

@[inline] def Elem.toNat (a : Elem) : Nat := JamCrypto.Fast.Fp25519.toNat a
@[inline] def Elem.isZero (a : Elem) : Bool := JamCrypto.Fast.Fp25519.isZero a
@[inline] def Elem.inv (a : Elem) : Elem := JamCrypto.Fast.Fp25519.inv a
@[inline] def Elem.sq (a : Elem) : Elem := JamCrypto.Fast.Fp25519.sq a

end JamCrypto.Fast.Fp25519
