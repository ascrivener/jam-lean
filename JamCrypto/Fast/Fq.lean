def isSquare (a : Elem) : Bool := powBits a halfBits == one

/-- Batch inversion (Montgomery's trick); zero entries map to zero. -/
def batchInv (xs : Array Elem) : Array Elem := Id.run do
  let n := xs.size
  let mut pre : Array Elem := Array.mkEmpty n
  let mut acc := one
  for x in xs do
    pre := pre.push acc
    if !isZero x then acc := mul acc x
  let mut iv := inv acc
