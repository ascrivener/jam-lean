/-- The blob `p` deblobs to `P`, and `facts` hold of it. -/
class HasCodeT1B (p : outParam ByteArray) (P : Program) : Prop where
  ok : CodeOk p facts P

/-- Where some facts hold of `P` and `checkCode` passes for these, these hold of `P` too. -/
theorem HasCodeT1B.of {p : ByteArray} {P : Program} {fs : List CodeFact} (h : CodeOk p fs P)
    (hx : checkCode p facts = true) : HasCodeT1B p P := by
  obtain ⟨P', h'⟩ := checkCode_sound hx
  have e : P' = P := Option.some.inj (h'.parse.symm.trans h.parse)
  exact ⟨e ▸ h'⟩


