theorem n56_from_0 {p : ByteArray} {P : Program} [HasCode p P] [HasCodeF p P] (x : X) (ω : Regs) (μ : Memory)
    (sp a : Nat) (hsp : 65536 ≤ sp ∧ sp + 200 < 4294967296) (ha : a + 32 < 4294967296)
    (h1 : ω[1] = UInt64.ofNat sp) (h7 : ω[7] = UInt64.ofNat a)
    (hra : ∀ c, a ≤ c → c < a + 32 → μ.readable c = true)
    (hw : ∀ c, sp ≤ c → c < sp + 200 → μ.writable c = true) :
    ∃ ω' μ', (FreeStepsH p R 56356 ω μ x 56921 ω' μ' x 224 ∨ FreeStepsH p R 56356 ω μ x 57346 ω' μ' x 224) ∧
      ω'[1] = ω[1] ∧ ω'[7] = ω[7] ∧ ω'[8] = ω[8] ∧
      (∀ c, c < 4294967296 → (c < sp ∨ sp + 200 ≤ c) → μ'.read c = μ.read c) ∧
      (∀ c, μ'.readable c = μ.readable c) ∧ (∀ c, μ'.writable c = μ.writable c) := by
  obtain ⟨ω1, μ1, hrun, e1, e7, e8, fr, rd, wr⟩ := n56_0 (p := p) (P := P) (R := R) x ω μ sp a hsp ha h1 h7 hra hw
  rcases hrun with hrun | hrun
  · obtain ⟨ω2, μ2, hrun2, f1, f7, f8, fr2, rd2, wr2⟩ := n56_from_1 (p := p) (P := P) (R := R) x ω1 μ1 sp a hsp ha
      (by rw [e1]; exact h1) (by rw [e7]; exact h7) (fun c h h' => by rw [rd]; exact hra c h h')
      (fun c h h' => by rw [wr]; exact hw c h h')
    refine ⟨ω2, μ2, ?_, by rw [f1, e1], by rw [f7, e7], by rw [f8, e8],
      fun c h h' => (fr2 c h h').trans (fr c h h'), fun c => (rd2 c).trans (rd c), fun c => (wr2 c).trans (wr c)⟩
    rcases hrun2 with h2 | h2
    · exact Or.inl ((hrun.trans h2).mono (by omega))
    · exact Or.inr ((hrun.trans h2).mono (by omega))
  · exact ⟨ω1, μ1, Or.inr (hrun.mono (by omega)), e1, e7, e8, fr, rd, wr⟩

/-- **56340's octet checks**: from 56356 to 56921 (past the last check) or to the hex path 57346,
    within 224 steps. -/
theorem n56_checks {p : ByteArray} {P : Program} [HasCode p P] [HasCodeF p P] (x : X) (ω : Regs) (μ : Memory)
    (sp a : Nat) (hsp : 65536 ≤ sp ∧ sp + 200 < 4294967296) (ha : a + 32 < 4294967296)
    (h1 : ω[1] = UInt64.ofNat sp) (h7 : ω[7] = UInt64.ofNat a)
    (hra : ∀ c, a ≤ c → c < a + 32 → μ.readable c = true)
    (hw : ∀ c, sp ≤ c → c < sp + 200 → μ.writable c = true) :
    ∃ ω' μ', (FreeStepsH p R 56356 ω μ x 56921 ω' μ' x 224 ∨ FreeStepsH p R 56356 ω μ x 57346 ω' μ' x 224) ∧
      ω'[1] = ω[1] ∧ ω'[7] = ω[7] ∧ ω'[8] = ω[8] ∧
      (∀ c, c < 4294967296 → (c < sp ∨ sp + 200 ≤ c) → μ'.read c = μ.read c) ∧
      (∀ c, μ'.readable c = μ.readable c) ∧ (∀ c, μ'.writable c = μ.writable c) :=
  n56_from_0 (p := p) (P := P) (R := R) x ω μ sp a hsp ha h1 h7 hra hw

