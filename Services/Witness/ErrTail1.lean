        PVM.getD_some', List.lookup_nil, Option.getD_none, and_self, and_true, true_and, hreg0, hreg1, hreg2, hreg3, hreg4, hreg5, hreg6, hreg7, hreg8, hreg9, hreg10, hreg11, hreg12]
    case mem =>
      try and_intros
      all_goals simp (disch := pvm_arith) only [PVM.Memory.read_writeN, PVM.reduceEncodeLE, PVM.Num.length_encodeLE,
        List.length_cons, List.length_nil, PVM.two32, Nat.reduceAdd, Nat.reduceSub, Nat.reduceLeDiff,
        Nat.reduceLT, and_true, true_and, and_false, false_and, ↓reduceIte, List.getElem!_cons_zero,
        List.getElem!_cons_succ, UInt8.reduceOfNat, and_self, PVM.Num.encodeLE] <;> chase_octet
    case frame =>
      intro a ha
      simp only [Bool.and_eq_true, decide_eq_true_eq, Bool.not_eq_true', decide_eq_false_iff_not,
        not_and, Nat.not_lt] at ha
      simp (disch := pvm_arith) only [PVM.Memory.read_writeN_disjoint, PVM.Num.length_encodeLE,
        List.length_cons, List.length_nil, PVM.two32]
    case rd => intro a; simp only [PVM.Memory.readable_writeN]
    case wr => intro a; simp only [PVM.Memory.writable_writeN]

end Services.Witness.ErrTail1
