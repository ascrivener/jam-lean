    ((4278059008 - 262144 ≤ q.1 ∧ q.1 < 4278059008) ∨ (196648 ≤ q.1 ∧ q.1 < 208896))) ∨
    (q ∈ rwBytes ∧ 196608 ≤ q.1 ∧ q.1 < 196648) ∨
    (q ∈ roBytes ∧ 65536 ≤ q.1 ∧ q.1 < 71464) := by
  decide

