/-- **The first 51 steps of witness's refine.** For any blob that passes `checkCode p facts`
    (the deployed witness blob does: `lake build witnesscheck`), the gas-free machine runs from the
    entry point to the instruction at 127866, through its host calls, for every refine
    environment, every argument length and every memory whose stack is writable. -/
theorem prefix_of_checkCode (p : ByteArray) (hc : checkCode p facts = true) :
    ∃ P, deblob p 0 = some P ∧ ∀ env μ L, StackWritable μ →
      ∃ ω' μ' x', FreeStepsH p (refineContract env) 0 (initRegs L) μ ((∅, []) : RefineCtx) 127866 ω' μ' x' := by
  obtain ⟨P, hP⟩ := checkCode_sound hc
  haveI : HasCode p P := ⟨hP⟩
  exact ⟨P, (d_0 (p := p)).1, fun env μ L hw => prefix_run p P env μ L hw⟩

