/-- Y's registers (GP eq. `registers`) for an argument of length `L`. -/
def initRegs (L : Nat) : Regs :=
  Vector.ofFn fun k => UInt64.ofNat (([4294901760, 4278059008, 0, 0, 0, 0, 0, 4278124544, 0, 0, 0, 0, 0] : List Nat).set 8 L |>.getD k.val 0)

/-- The stack (2^32 − 2𝖹_Z − 𝖹_I − 𝖹_P·⌈s/𝖹_P⌉ to 2^32 − 2𝖹_Z − 𝖹_I) is writable. -/
def StackWritable (μ : Memory) : Prop :=
  ∀ a, 4278059008 - 262144 ≤ a → a < 4278059008 → μ.writable a = true

theorem prefix_run (p : ByteArray) (P : Program) [HasCode p P] (μ : Memory) (L : Nat)
    (hw : StackWritable μ) : ∃ ω' μ', FreeSteps p 0 (initRegs L) μ 127787 ω' μ' := by
  have hr : ∀ a, 4278059008 - 262144 ≤ a → a < 4278059008 → μ.readable a = true :=
    fun a h1 h2 => Memory.readable_of_writable (hw a h1 h2)
  unfold StackWritable at hw
  refine ⟨?ω, ?μ, ?h⟩
  case h =>
    apply FreeSteps.step_decode (d_0 (p := p) (P := P))
    · pvm_simp [hw, hr, initRegs, List.set_cons_succ, List.set_cons_zero]
    apply FreeSteps.step_decode (d_43114 (p := p) (P := P))
